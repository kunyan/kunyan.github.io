---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { resolveGalleryImage } from "../../lib/photos";
import { t } from "../../i18n/ui";
import { formatDate } from "../../i18n/utils";
import type { Lang } from "../../i18n/config";

interface Props {
  lang: Lang;
  photos: CollectionEntry<"gallery">[];
}

const { lang, photos } = Astro.props;
---

{
  photos.map((photo) => {
    const image = resolveGalleryImage(photo.data.image);
    return (
      <template id={`photo-${photo.id}`} data-slug={photo.id}>
        <div class="lb-photo">
          <Image
            src={image}
            alt={photo.data.title}
            widths={[1200, 1800, 2400]}
            sizes="(min-width: 1024px) calc(100vw - 22rem), 100vw"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-contain"
          />
        </div>
        <aside class="lb-meta">
          <h2 class="text-lg font-semibold text-foreground">
            {photo.data.title}
          </h2>
          {photo.data.caption && (
            <p class="mt-2 text-sm text-muted-foreground">
              {photo.data.caption}
            </p>
          )}
          <dl class="mt-6 space-y-2 text-sm text-muted-foreground">
            <div>
              <dt class="sr-only">Date</dt>
              <dd>
                <time datetime={photo.data.date.toISOString()}>
                  {formatDate(photo.data.date, lang)}
                </time>
              </dd>
            </div>
            {photo.data.location && (
              <div>
                <dt class="sr-only">Location</dt>
                <dd>{photo.data.location}</dd>
              </div>
            )}
          </dl>
          {photo.data.tags.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-2">
              {photo.data.tags.map((tag) => (
                <li class="rounded-full border border-border px-2.5 py-0.5 text-xs text-muted-foreground">
                  #{tag}
                </li>
              ))}
            </ul>
          )}
        </aside>
      </template>
    );
  })
}

<dialog
  id="gallery-lightbox"
  aria-label="Photo viewer"
  class="fixed inset-0 z-[60] m-0 hidden h-full max-h-none w-full max-w-none bg-black/95 p-0 text-foreground backdrop:bg-black/80"
>
  <div class="relative flex h-full w-full flex-col lg:flex-row">
    <button
      type="button"
      id="lb-close"
      class="absolute top-3 right-3 z-10 inline-flex h-10 w-10 items-center justify-center rounded-full bg-black/40 text-white hover:bg-black/60"
      aria-label={t(lang, "gallery.closeLightbox")}
    >
      <Icon name="lucide:x" width={20} height={20} />
    </button>
    <button
      type="button"
      id="lb-prev"
      class="absolute top-1/2 left-3 z-10 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/40 text-white hover:bg-black/60"
      aria-label={t(lang, "gallery.prevPhoto")}
    >
      <Icon name="lucide:chevron-left" width={22} height={22} />
    </button>
    <button
      type="button"
      id="lb-next"
      class="absolute top-1/2 right-3 z-10 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/40 text-white hover:bg-black/60 lg:right-[22rem]"
      aria-label={t(lang, "gallery.nextPhoto")}
    >
      <Icon name="lucide:chevron-right" width={22} height={22} />
    </button>
    <div
      id="lb-photo-slot"
      class="flex flex-1 items-center justify-center p-4 lg:p-8"
    ></div>
    <div
      id="lb-meta-slot"
      class="border-t border-white/10 bg-black/40 p-6 text-sm text-white/80 lg:w-[22rem] lg:border-t-0 lg:border-l lg:overflow-y-auto"
    ></div>
  </div>
</dialog>

<style>
  /* Make Image rendered inside the photo slot fill its area on desktop. */
  #gallery-lightbox .lb-photo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  #gallery-lightbox .lb-meta h2 { color: white; }
  #gallery-lightbox .lb-meta { color: rgba(255, 255, 255, 0.75); }
</style>

<script is:inline>
  (function () {
    function init() {
    const dialog = document.getElementById("gallery-lightbox");
    const photoSlot = document.getElementById("lb-photo-slot");
    const metaSlot = document.getElementById("lb-meta-slot");
    const grid = document.getElementById("gallery-grid");
    const closeBtn = document.getElementById("lb-close");
    const prevBtn = document.getElementById("lb-prev");
    const nextBtn = document.getElementById("lb-next");
    if (!dialog || !photoSlot || !metaSlot || !grid) return;

    let currentSlug = null;

    function visibleItems() {
      return Array.from(grid.querySelectorAll(".gallery-item")).filter(
        (el) => el.offsetParent !== null,
      );
    }

    function renderSlug(slug) {
      const tpl = document.getElementById("photo-" + slug);
      if (!(tpl instanceof HTMLTemplateElement)) return false;
      const clone = tpl.content.cloneNode(true);
      const photoEl = clone.querySelector(".lb-photo");
      const metaEl = clone.querySelector(".lb-meta");
      photoSlot.replaceChildren(photoEl);
      metaSlot.replaceChildren(metaEl);
      return true;
    }

    function open(slug) {
      if (!renderSlug(slug)) return;
      currentSlug = slug;
      dialog.classList.remove("hidden");
      if (typeof dialog.showModal === "function" && !dialog.open) {
        try { dialog.showModal(); } catch {}
      }
      if (location.hash !== "#" + slug) {
        history.replaceState(null, "", "#" + slug);
      }
      document.body.style.overflow = "hidden";
    }

    function close() {
      dialog.classList.add("hidden");
      if (typeof dialog.close === "function" && dialog.open) {
        try { dialog.close(); } catch {}
      }
      photoSlot.replaceChildren();
      metaSlot.replaceChildren();
      currentSlug = null;
      if (location.hash) {
        history.replaceState(null, "", location.pathname + location.search);
      }
      document.body.style.overflow = "";
    }

    function step(delta) {
      if (!currentSlug) return;
      const items = visibleItems();
      if (items.length === 0) return;
      const idx = items.findIndex((el) => el.getAttribute("data-slug") === currentSlug);
      if (idx === -1) {
        open(items[0].getAttribute("data-slug"));
        return;
      }
      const next = items[(idx + delta + items.length) % items.length];
      const slug = next.getAttribute("data-slug");
      if (slug) open(slug);
    }

    grid.addEventListener("click", (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const item = target.closest(".gallery-item");
      if (!item) return;
      const slug = item.getAttribute("data-slug");
      if (slug) open(slug);
    });

    closeBtn?.addEventListener("click", close);
    prevBtn?.addEventListener("click", () => step(-1));
    nextBtn?.addEventListener("click", () => step(1));

    dialog.addEventListener("click", (e) => {
      // Click on backdrop (dialog itself, not inner content) closes the lightbox.
      if (e.target === dialog) close();
    });

    document.addEventListener("keydown", (e) => {
      if (dialog.classList.contains("hidden")) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") step(-1);
      else if (e.key === "ArrowRight") step(1);
    });

    window.addEventListener("hashchange", () => {
      const slug = location.hash.replace(/^#/, "");
      if (!slug) {
        if (!dialog.classList.contains("hidden")) close();
        return;
      }
      if (slug !== currentSlug) open(slug);
    });

    // Deep link on initial load
    const initial = location.hash.replace(/^#/, "");
    if (initial) open(initial);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  })();
</script>

---
import { Image } from 'astro:assets';
import { formatDate, getReadingTime, postHref, type PostEntry } from '../i18n/utils';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/config';
import { resolveCover } from '../lib/covers';

interface Props {
  post: PostEntry;
  lang: Lang;
}

const { post, lang } = Astro.props;
const href = postHref(post);
const cover = resolveCover(post.data.cover);
---

<a
  href={href}
  class="group block focus-visible:outline-none"
  aria-label={post.data.title}
>
  <article class="flex h-full flex-col">
    <div
      class="relative aspect-[16/10] w-full overflow-hidden rounded-lg border border-border bg-muted"
    >
      <Image
        src={cover}
        alt=""
        widths={[480, 800]}
        sizes="(min-width: 1280px) 25vw, (min-width: 640px) 50vw, 100vw"
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 ease-out lg:group-hover:scale-105"
      />
    </div>

    <div class="mt-4 flex flex-1 flex-col">
      <h3 class="text-base font-semibold tracking-tight text-foreground">
        {post.data.title}
      </h3>
      <p
        class="mt-2 text-sm leading-relaxed text-muted-foreground"
        style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden"
      >
        {post.data.excerpt}
      </p>

      <div
        class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground"
      >
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
        <span aria-hidden="true">·</span>
        <span>{getReadingTime(post)} {t(lang, 'posts.readSuffix')}</span>
        <span aria-hidden="true">·</span>
        <span class="flex flex-wrap gap-1.5">
          {
            post.data.tags.map((tag) => (
              <span class="text-foreground/80">#{tag}</span>
            ))
          }
        </span>
      </div>
    </div>
  </article>
</a>

    <!-- Red Hat: 3 positions -->
    <div class="pt-1 pb-3.5 border-b border-zinc-200">
        <div class="flex justify-between items-baseline gap-4 pb-2.5">
            <div
                class="text-[16px] font-semibold tracking-[-0.01em] text-zinc-950 print:text-[11pt]"
            >
                Red Hat
            </div>
            <div
                class="text-[12.5px] text-zinc-500 tabular-nums print:text-[8.5pt]"

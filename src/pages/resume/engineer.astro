---
import "../../styles/global.css";
import Award from "../../components/resume/Award.astro";
import Certification from "../../components/resume/Certification.astro";
import Education from "../../components/resume/Education.astro";
import Experience from "../../components/resume/Experience.astro";
import Header from "../../components/resume/Header.astro";
import Language from "../../components/resume/Language.astro";
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>闫坤 · Principal Software Engineer</title>
    </head>

    <body
        class="bg-zinc-50 text-zinc-950 font-sans text-[14px] leading-[1.6] m-0 p-0
             print:bg-white print:text-[9.5pt] print:leading-[1.55]"
    >
        <main
            class="mx-auto my-10 max-w-190 bg-white border border-zinc-200 rounded-xl
             px-16 pt-14 pb-16
             shadow-[0_1px_2px_rgb(9_9_11/0.04),0_8px_24px_rgb(9_9_11/0.04)]
             print:m-0 print:max-w-full print:border-0 print:rounded-none
             print:shadow-none print:p-0
             max-md:mx-4 max-md:my-4 max-md:px-6 max-md:py-8"
        >
            <!-- ========== HEADER ========== -->
            <Header />

            <!-- ========== ABOUT ========== -->
            <section class="mt-9 print:mt-5 py-8">
                <h2 class="h-section">
                    <span class="zh">个人简介</span> About
                </h2>
                <p
                    class="text-[13.5px] leading-[1.75] text-zinc-950 text-pretty m-0 print:text-[9.5pt] print:leading-[1.6]"
                >
                    拥有15年以上全栈开发与架构设计经验，技术栈涵盖
                    <ul
                        class="max-w-md space-y-1 text-body list-disc list-inside ml-4"
                    >
                        <li>
                            前端（React、Astro、Next.js、AngularJS、WebComponent）
                        </li>
                        <li>后端（Express、Koa、Fastify、NestJS、Spring）</li>
                        <li>
                            数据库（MariaDB/MySQL、MongoDB、Prisma、Sequelize）
                        </li>
                        <li>
                            CI/CD（Jenkins、OpenShift Pipeline、Gitlab
                            CI、GitHub Actions
                        </li>
                    </ul>及云原生基础设施，对主流编程语言均有实际应用经验。
                    <br /><br />
                    主导团队应用开发与运维架构设计，覆盖全栈项目及SPA架构，近期重点参与Agent、MCP
                    Server及Skills模块开发。熟悉Claude Code、Open Code等AI辅助开发工具，提升开发效率与代码质量。
                    <br /><br />
                    具备跨国项目协作经验，工作语言以英语为主，团队成员来自多个国家，规模均在10人以上。项目管理采用Scrum与Kanban模式，具备跨文化团队管理与高效协作能力。
                </p>
            </section>

            <!-- ========== EXPERIENCE ========== -->
            <Experience />

            <!-- ========== PROJECTS ========== -->
            <section class="mt-9 print:mt-5">
                <h2 class="h-section">
                    <span class="zh">项目经验</span>
                    Selected Projects
                </h2>

                <!-- helper macro repeated inline below; each .project div uses the same shape -->

                <article
                    class="py-4.5 border-b border-zinc-200 first:pt-1 last:border-b-0 last:pb-1"
                >
                    <div class="flex items-baseline justify-between gap-4 mb-1">
                        <div
                            class="text-[15px] font-semibold tracking-[-0.01em] print:text-[10.5pt]"
                        >
                            Red Hat CVE MCP Server
                        </div>
                        <div
                            class="text-[12.5px] text-zinc-500 tabular-nums whitespace-nowrap print:text-[8.5pt]"
                        >
                            Tech Lead<span class="sep"></span>2025 / 11 — 当前
                        </div>
                    </div>
                    <div
                        class="text-[12.5px] text-zinc-500 mb-2.5 print:text-[8.5pt]"
                    >
                        于 Red Hat
                    </div>
                    <ul class="proj-list">
                        <li>
                            主导基于官方 MCP SDK 与红帽 Hydra API 的 CVE MCP
                            Server 开发，提供 <code>cve_details</code> 与
                            <code>cve_list</code> 两个核心工具，支持自然语言查询，如「最新的
                            10 个影响 RHEL 9 的 CVE」。
                        </li>
                        <li>
                            设计并实现 CVE
                            数据高效检索与结构化输出机制，响应准确率 95%
                            以上，平均延迟低于 300 ms。
                        </li>
                        <li>
                            推动服务与大模型平台集成，上线后日均调用量超 5,000
                            次，显著提升安全团队对 RHEL 系统漏洞的响应效率。
                        </li>
                    </ul>
                    <div class="flex flex-wrap gap-1.5 pt-0.5">
                        <span class="badge">TypeScript</span><span class="badge"
                            >MCP Server</span
                        ><span class="badge">OpenShift</span><span class="badge"
                            >GitLab CI</span
                        >
                    </div>
                </article>

                <article
                    class="py-4.5 border-b border-zinc-200 first:pt-1 last:border-b-0 last:pb-1"
                >
                    <div class="flex items-baseline justify-between gap-4 mb-1">
                        <div
                            class="text-[15px] font-semibold tracking-[-0.01em] print:text-[10.5pt]"
                        >
                            Red Hat Security Agent
                        </div>
                        <div
                            class="text-[12.5px] text-zinc-500 tabular-nums whitespace-nowrap print:text-[8.5pt]"
                        >
                            技术负责人<span class="sep"></span>2025 / 11 — 当前
                        </div>
                    </div>
                    <div
                        class="text-[12.5px] text-zinc-500 mb-2.5 print:text-[8.5pt]"
                    >
                        于 Red Hat
                    </div>
                    <ul class="proj-list">
                        <li>
                            主导基于 Google ADK 框架的安全智能代理系统开发，集成
                            IT 部门 MaaS 服务（vLLM）与多个 MCP
                            Servers，构建红帽安全知识问答引擎。
                        </li>
                        <li>
                            实现用户自然语言查询自动匹配
                            CVE、合规性（Compliance）等红帽安全解决方案，响应准确率
                            90%+，日均处理请求超 5,000 次。
                        </li>
                        <li>
                            设计模块化架构支持多模型 provider
                            灵活切换，提升系统可维护性与扩展性，推动团队研发效率提升
                            30%。
                        </li>
                    </ul>
                    <div class="flex flex-wrap gap-1.5 pt-0.5">
                        <span class="badge">Google ADK</span><span class="badge"
                            >Python</span
                        ><span class="badge">Agent</span><span class="badge"
                            >vLLM</span
                        >
                    </div>
                </article>

                <article
                    class="py-4.5 border-b border-zinc-200 first:pt-1 last:border-b-0 last:pb-1"
                >
                    <div class="flex items-baseline justify-between gap-4 mb-1">
                        <div
                            class="text-[15px] font-semibold tracking-[-0.01em] print:text-[10.5pt]"
                        >
                            Red Hat ProdSec Compliance
                        </div>
                        <div
                            class="text-[12.5px] text-zinc-500 tabular-nums whitespace-nowrap print:text-[8.5pt]"
                        >
                            技术负责人<span class="sep"></span>2023 / 7 — 当前
                        </div>

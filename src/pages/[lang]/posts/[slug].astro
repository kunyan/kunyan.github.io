---
import type { GetStaticPaths } from "astro";
import { Image, getImage } from "astro:assets";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Toc from "../../../components/react/Toc.tsx";
import BackToTop from "../../../components/react/BackToTop.tsx";
import Comments from "../../../components/Comments.astro";
import { Icon } from "astro-icon/components";
import { resolveCover } from "../../../lib/covers";
import { isConfigured as giscusConfigured } from "../../../lib/giscus";
import { languages, type Lang, isLang } from "../../../i18n/config";
import { t } from "../../../i18n/ui";
import {
  formatDate,
  getCounterpart,
  getPostsByLang,
  getReadingTime,
  postHref,
  postLang,
  postSlug,
  type PostEntry,
} from "../../../i18n/utils";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { lang: postLang(post), slug: postSlug(post) },
    props: { post },
  }));
}) satisfies GetStaticPaths;

interface PageProps {
  post: PostEntry;
}

const { post } = Astro.props as PageProps;
const lang = Astro.params.lang;
if (!isLang(lang)) throw new Error(`Invalid lang param: ${lang}`);

const { Content, headings } = await render(post);
const cover = resolveCover(post.data.cover);

const sameLangPosts = await getPostsByLang(lang);
const idx = sameLangPosts.findIndex((p) => p.id === post.id);
const prev = idx > 0 ? sameLangPosts[idx - 1] : null;
const next =
  idx >= 0 && idx < sameLangPosts.length - 1 ? sameLangPosts[idx + 1] : null;

const otherLang: Lang = languages.find((l) => l !== lang) ?? lang;
const counterpart = await getCounterpart(post, otherLang);
const counterpartPath = counterpart ? postHref(counterpart) : null;

const pageTitle = `${post.data.title} · ${t(lang, "meta.siteName")}`;

// Warm Giscus + GitHub API connections only when this post will actually render comments.
const commentsRender = post.data.comments !== false && giscusConfigured();
const preconnect = commentsRender
  ? ["https://giscus.app", "https://api.github.com"]
  : [];

// Pre-resolve a 1200×630 OG image (Open Graph / Twitter Card standard) from the cover.
const ogVariant = await getImage({ src: cover, width: 1200, format: "webp" });
const ogImage = new URL(ogVariant.src, Astro.site).toString();

// Schema.org BlogPosting JSON-LD — gives Google enough to render a rich result.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const author = {
  "@type": "Person",
  name: "Kun Yan",
  url: Astro.site?.toString() ?? "https://yankun.org/",
};
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.excerpt,
  image: ogImage,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author,
  publisher: author,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
  inLanguage: lang === "zh" ? "zh-CN" : "en-US",
  keywords: post.data.tags.join(", "),
};
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={post.data.excerpt}
  counterpartPath={counterpartPath}
  preconnect={preconnect}
  ogImage={ogImage}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
  tags={post.data.tags}
  jsonLd={articleSchema}
>
  <article class="mx-auto w-full max-w-350 px-6 pt-12 pb-24 lg:px-10">
    <div
      class="lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-12 xl:grid-cols-[minmax(0,1fr)_260px] xl:gap-16"
    >
      <div class="mx-auto w-full max-w-[70ch] lg:mx-0 lg:max-w-none">
        <a
          href={`/${lang}/posts/`}
          class="mb-8 inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          <Icon name="lucide:arrow-left" width={14} height={14} />
          {t(lang, "post.backToAll")}
        </a>

        <h1
          class="text-balance text-4xl font-semibold leading-[1.1] tracking-tight sm:text-5xl"
        >
          {post.data.title}
        </h1>

        <div
          class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted-foreground"
        >
          <span class="inline-flex items-center gap-1.5">
            <Icon name="lucide:calendar" width={14} height={14} />
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date, lang)}
            </time>
          </span>
          <span aria-hidden="true">·</span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="lucide:clock" width={14} height={14} />
            {getReadingTime(post)}
            {t(lang, "posts.readSuffix")}
          </span>
          <span aria-hidden="true">·</span>
          <span class="flex flex-wrap gap-1.5">
            {
              post.data.tags.map((tag) => (
                <span class="inline-flex items-center rounded-md bg-secondary px-2 py-0.5 text-xs font-medium text-secondary-foreground">
                  {tag}
                </span>
              ))
            }
          </span>
        </div>

        <figure
          class="mt-10 overflow-hidden rounded-lg border border-border bg-muted"
        >
          <Image
            src={cover}
            alt=""
            widths={[800, 1200, 1600]}
            sizes="(min-width: 1280px) 1140px, (min-width: 1024px) calc(100vw - 320px), 100vw"
            class="h-auto w-full"
            loading="eager"
          />
        </figure>

        <p
          class="mt-10 text-balance text-xl leading-relaxed text-muted-foreground"
        >
          {post.data.excerpt}
        </p>

        <hr class="my-10 border-border" />

        <div class="prose-blog">
          <Content />
        </div>

        <nav
          class="mt-20 grid grid-cols-1 gap-4 border-t border-border pt-10 sm:grid-cols-2"
        >
          {
            prev ? (
              <a
                href={postHref(prev)}
                class="group flex flex-col gap-1 rounded-lg border border-border p-4 transition-colors hover:bg-accent"
              >
                <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">
                  <Icon name="lucide:arrow-left" width={12} height={12} />
                  {t(lang, "post.previous")}
                </span>
                <span class="line-clamp-2 text-sm font-medium tracking-tight">
                  {prev.data.title}
                </span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a
                href={postHref(next)}
                class="group flex flex-col gap-1 rounded-lg border border-border p-4 text-right transition-colors hover:bg-accent"
              >
                <span class="inline-flex items-center justify-end gap-1 text-xs text-muted-foreground">
                  {t(lang, "post.next")}
                  <Icon name="lucide:arrow-right" width={12} height={12} />
                </span>
                <span class="line-clamp-2 text-sm font-medium tracking-tight">
                  {next.data.title}
                </span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>

        {
          post.data.comments !== false && (
            <section class="mt-20 border-t border-border pt-10">
              <h2 class="mb-6 text-base font-semibold tracking-tight">
                {t(lang, "post.comments")}
              </h2>
              <Comments lang={lang} />
            </section>
          )
        }
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <Toc client:load headings={headings} label={t(lang, "post.toc")} />
        </div>
      </aside>
    </div>
  </article>

  <BackToTop client:load label={t(lang, "post.backToTop")} />
</BaseLayout>
